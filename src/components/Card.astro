---
const { title, description, bgimage, label, udsolgt, url } = Astro.props;
---

<a href={url}>
    <article
        class={udsolgt && "dim"}
        style=`background-image: url(images/${bgimage})`
    >
        <h2>{title}</h2>
        <p>
            {description}
        </p>
        {label && <p class="label">Få billetter</p>}
    </article>
</a>

<style>
    article {
        position: relative;
        background-size: cover;
        padding: 2rem;
        color: white;
        aspect-ratio: 6.2/9;
    }
    a {
        text-decoration: none;
    }
    img {
        max-width: 100%;
        aspect-ratio: inherit;
    }
    .label {
        position: absolute;
        top: 0;
        right: 1rem;
        padding: 1rem;
        background-color: orange;
        rotate: 5deg;
    }
    .dim {
        filter: grayscale(1);
        color: grey;
        opacity: 0.2;
    }
    article:hover {
        filter: hue-rotate(80deg);
    }
</style>

---
const { title, description, bgimage, udsolgt } = Astro.props;
---

<article style=`background-image: url(images/${bgimage})`>
    <h2>{title}</h2>
    <p>
        {description}
    </p>
    {udsolgt && <p class="label">Udsolgt</p>}
</article>

<style>
    article {
        position: relative;
        background-size: cover;
        padding: 2rem;
        color: white;
        aspect-ratio: 6.2/9;
    }
    img {
        max-width: 100%;
        aspect-ratio: inherit;
    }
    .label {
        position: absolute;
        top: 0;
        right: 1rem;
        padding: 1rem;
        background-color: orange;
        rotate: 5deg;
    }
</style>

---
const { title, description, bgimage } = Astro.props;
---

<article style=`background-image: url(images/${bgimage})`>
    <h2>{title}</h2>
    <p>
        {description}
    </p>
</article>

<style>
    article {
        background-size: cover;
        padding: 2rem;
        color: white;
        aspect-ratio: 6.2/9;
    }
    img {
        max-width: 100%;
        aspect-ratio: inherit;
    }
</style>
